<%= render 'shared/flash_message' %>
<div class="d-flex flex-column top-wrapper">
    <div class="d-flex flex-column ">
        <div class="flex-grow-1 d-flex flex-column align-items-center openbook-wrapper">
            <div>
                <h2 class="text-dark-emphasis m-3">今日の道しるべ</h2>
                <h2 class="text-dark-emphasis m-3"><%= @today %>(<%= @day_of_week %>)</h2>
            </div>
            <div class="d-flex flex-grow-1 flex-column justify-content-center align-items-center mb-5">
              <% if @post.nil? %>
                <span class="fs-1">「栞を挟む」から心に残った一文を記録してみよう</span>
              <% else %>
                <span class="fs-1 quote_content"><%= @post.content %></span>
                <span class="fs-2 mt-4 quote_content"><%= @post.source %></span>
              <% end %>
            </div>
        </div>
    </div>
</div>
