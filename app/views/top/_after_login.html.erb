<div class="h-50 d-flex flex-column">
    <h2><%= @today %>(<%= @day_of_week %>)</h2>
    <div class="bg-light h-75 d-flex flex-column">
        <div>
            <h4 class="text-dark-emphasis m-3">今日の道しるべ</h4>
        </div>
        <div class="d-flex flex-column justify-content-center align-items-center h-75">
            <span>大丈夫きっとまた会えるよ</span>
            <span class="mt-4">夏目友人帳</span>
        </div>    
    </div>
</div>

<div class="d-flex justify-content-between">
    <div>
        <h2><%= t('posts.index.title')%></h2>
        <p>誰かの心の跡をたどる</p>
        <%= link_to t('top.index'), posts_path, class: "btn btn-light" %>
    </div>

    <div>
        <h2><%= t('posts.my_posts.title') %></h2>
        <p>過去の自分を紐解く</p>
        <%= link_to t('top.my_posts'), my_posts_posts_path, class: "btn btn-light" %>
    </div>

    <div>
        <h2><%= t('posts.new.title') %></h2>
        <p>心に残った一文を記録する</p>
        <%= link_to t('top.edit'), new_post_path, class: "btn btn-light" %>
    </div>
</div>