<h2><%= t('posts.my_posts.title') %></h2>
<%= render 'shared/flash_message' %>
<div id="posts">
<% if @posts.any? %>
    <% @posts.each do |post| %>
        <%= render partial: 'post', locals: { post: post, show_user_name: false } %>
        <div class="m-2 d-flex justify-content-end">
            <%= link_to t('posts.show.title'), post, class: "btn btn-danger w-25" %>
        </div>
    <% end %>
<% else %>
    <p><%= t('posts.index.no_post') %></p>
<% end %>
</div>
