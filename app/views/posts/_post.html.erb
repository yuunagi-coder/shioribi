<div id="<%= dom_id post %>" class="page flex-column d-flex bg-light justify-content-between align-items-center">
<% if local_assigns[:show_user_name] %>
    <div class="d-flex post-header align-items-start">
        <i class="bi bi-person-circle m-3"></i>
        <p class="m-2 fs-4">
            <%= post.user.name %>
        </p>
    </div>
<% end %>
    <div class="post-body d-flex flex-column justify-content-center align-items-center">
        <p class="m-2 fs-2 quote_content">
            <%= post.content %>
        </p>
        <p class="m-2 fs-4 quote_content">
            『<%= post.source %>』
        </p>
    </div>
    <div class="post-footer">
        <p class="m-2 fs-4">
            <% post.emotion_tags.each do |tag| %>
                <span class="badge text-bg-secondary"><%= tag.name %></span>
            <% end %>
        </p>
    </div>
</div>