<div id="<%= dom_id post %>" class="bg-light d-flex flex-column m-3">
<% if local_assigns[:show_user_name] %>
    <p class="m-2">
        <%= post.user.name %>
    </p>
<% end %>
    <p class="m-2">
        <strong><%= t('posts.content')%>:</strong>
        <%= post.content %>
    </p>
    <p class="m-2">
        <strong><%= t('posts.source')%>:</strong>
        <%= post.source %>
    </p>
</div>