<div class="d-flex flex-column justify-content-center align-items-center mt-5">
    <h1><%= t('user_sessions.new.title') %></h1>
</div>

<div class="input-group gap-3 mt-3 d-flex flex-column justify-content-center align-items-center">
<%= form_with(url: login_path) do |form| %>
    <div>
        <%= form.label :email, t('helpers.label.email'), style: "display: block" %>
        <%= form.text_field :email,value: params[:email],class: 'form-control' %>
    </div>
    <div class="mt-2">
        <%= form.label :password, t('helpers.label.password'),style: "display:block" %>
        <%= form.password_field :password,class: 'form-control' %>
    </div>

    <div class="my-3 d-flex flex-column justify-content-center align-items-center">
        <%= form.submit t('user_sessions.new.login') ,class: "btn btn-danger w-50" %>
    </div>
<% end %>
    <div class="d-flex flex-column justify-content-center align-items-center">
        <%= link_to t('user_sessions.new.to_register_page') ,new_user_path, class: "btn btn-light w-100 " %>
    </div>
</div>
