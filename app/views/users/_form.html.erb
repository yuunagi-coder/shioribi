<%= form_with model: user, local: true do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="input-group flex-column gap-3 mt-5">
    <div>
      <%= form.label :name, 'ユーザー名', style: "display: block" %>
      <%= form.text_field :name, class: 'form-control' %>
    </div>
    
    <div>
      <%= form.label :email, 'メールアドレス', style: "display: block" %>
      <%= form.text_field :email, class: 'form-control' %>
    </div>

    <div>
      <%= form.label :password, 'パスワード', style: "display: block" %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>
    
    <div>
      <%= form.label :password_confirmation, 'パスワード確認', style: "display: block" %>
      <%= form.password_field :password_confirmation, class: 'form-control' %>
    </div>

    <div>
      <%= form.submit '登録', class: "btn btn-danger w-75" %>
    </div>
  </div>
<% end %>